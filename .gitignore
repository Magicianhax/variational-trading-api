# These carry keys or sessions: Chrome's "Pack extension" writes a signing key (*.pem)
# next to the packed extension (*.crx, *.zip), and a DevTools HAR capture holds every
# cookie the browser sent.
*.pem
*.crx
*.zip
*.har

