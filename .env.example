# Copy to .env and fill in. .env is git-ignored — never commit it.

# Your session, on ONE line: the Cookie header from any request to
# omni.variational.io/api while signed in, or the browser extension's "Copy session JSON"
# output. Surrounding quotes are fine. A ./session.json file takes precedence over this.
# See docs/AUTH.md.
VARIATIONAL_COOKIES=

# OPTIONAL, ADVANCED — not needed if you set VARIATIONAL_COOKIES. An EOA private key for
# SIWE login (examples/login-with-private-key.ts). Whoever holds it holds the funds.
# VARIATIONAL_PRIVATE_KEY=

# Leave true until you mean it. Any value other than an explicit "false" is dry run.
DRY_RUN=true
