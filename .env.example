# Copy to .env and fill in. .env is git-ignored — never commit it.

# Only needed for programmatic SIWE login (docs/AUTH.md). An EOA private key for the
# account you trade with. Whoever holds this file holds the funds.
VARIATIONAL_PRIVATE_KEY=

# Alternatively: a cookie header copied from a logged-in browser (docs/AUTH.md).
VARIATIONAL_COOKIES=

# Leave true until you mean it. Any value other than an explicit "false" is dry run.
DRY_RUN=true
