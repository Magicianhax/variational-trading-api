{
  "name": "variational-trading-api",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial, reverse-engineered, typed TypeScript client for the Variational Omni trading API.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "tsc -b",
    "build:extension": "pnpm --filter variational-session-exporter build",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && pnpm typecheck:extension",
    "typecheck:extension": "pnpm --filter variational-session-exporter typecheck",
    "test": "vitest run",
    "test:extension": "pnpm --filter variational-session-exporter test",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "session:check": "tsc -b && node --experimental-strip-types scripts/session-check.ts",
    "smoke": "tsc -b && node --experimental-strip-types scripts/smoke.ts",
    "example": "tsc -b && node --experimental-strip-types"
  },
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "rollup": "4.62.4"
  }
}
